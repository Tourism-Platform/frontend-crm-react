VITE_API_URL=
VITE_DOCUMENT_API_URL=
# true — все запросы к API обслуживает MSW (только dev-сервер); незамоканные отвечают 501
VITE_ENABLE_MSW=
VITE_APP_ENV=

# Мониторинг (Sentry): без DSN выключен; в dev отправка только при VITE_SENTRY_ENABLED=true
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=
# Тег сборки — тот же, что release source maps
VITE_APP_RELEASE=
# Загрузка source maps при сборке (без токена плагин выключен)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# npm run seed:all / seed:tour / seed:booking / …
# Operator
SEED_EMAIL=damirk355@gmail.com
SEED_PASSWORD=String1!
# Agency booking user
SEED_BOOKING_EMAIL=damirk366@gmail.com
SEED_BOOKING_PASSWORD=String1!
# Optional overrides
# SEED_OPERATOR_EMAIL=
# SEED_OPERATOR_PASSWORD=
# SEED_BOOKING_ID=
# SEED_TOUR_COUNT=25
